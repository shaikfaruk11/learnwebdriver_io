{
  "name": "learnwebdriver_io",
  "type": "module",
  "devDependencies": {
    "@applitools/eyes-webdriverio": "^5.62.0",
    "@types/node": "^26.6.6",
    "@wdio/allure-reporter": "^10.1.0",
    "@wdio/appium-service": "^10.1.0",
    "@wdio/cli": "^10.1.0",
    "@wdio/globals": "^10.1.0",
    "@wdio/junit-reporter": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/sauce-service": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "@wdio/visual-service": "^11.0.0",
    "allure-commandline": "^2.46.1",
    "appium": "^3.9.0",
    "appium-uiautomator2-driver": "^8.7.3",
    "appium-xcuitest": "^1.0.0",
    "appium-xcuitest-driver": "^12.22.8",
    "expect-webdriverio": "^8.0.0"
  },
  "scripts": {
    "wdio:remote": "wdio run ./wdio.remote.conf.ts",
    "wdio:local": "wdio run ./wdio.local.conf.ts",
    "wdio:remote:ios": "wdio run ./wdio.remote.conf.ts --device=ios",
    "wdio:remote:android": "wdio run ./wdio.remote.conf.ts --device=android",
    "wdio:local:android": "wdio run ./wdio.local.conf.ts --device=android",
    "wdio:local:ios": "wdio run ./wdio.local.conf.ts --device=ios",
    "wdio:generatereport":"npx allure generate allure-results --clean -o allure-report",
    "wdio:openreport":"npx allure open allure-report",
    "wdio:removeoldreportdetails":"rm -rf allure-results allure-report reports/junit"
  }
}
